# Dependencies
node_modules/

# Build output
.next/

# Environment — never commit secrets
.env.local
.env*.local

# System
.DS_Store
*.pem

# Logs
*.log
npm-debug.log*
*.tsbuildinfo

# PM2
.pm2/

# Turbopack
.next/cache/

# Convex generated code is COMMITTED, not ignored.
#
# It was ignored here on the assumption that `convex deploy` regenerates it
# during the build. It does not — on a Git-triggered Vercel build the clone has
# no _generated directory and `convex deploy --cmd` goes straight to the build
# command, so every import of @/convex/_generated/api fails to resolve. The CLI
# deploys that preceded the GitHub integration only worked because they
# uploaded a local copy. Convex's own templates check this directory in.

# Local task data / uploads (persisted on the server, not in git)
/data/
/public/uploads/
.vercel
.env*
